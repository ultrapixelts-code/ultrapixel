# PHP upload limits for label files (Apache mod_php hosting; PHP-FPM uses .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 32M
  php_value post_max_size 34M
</IfModule>
# Keep configuration and library files private; never list this folder.
Options -Indexes
<FilesMatch "^(config(\.sample)?\.php|lib\.php|\.user\.ini|.*\.(db|sqlite|md))$">
  Require all denied
</FilesMatch>
# Pass the Authorization header to PHP on hosts that run it as CGI/FPM (needed for the admin login).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex"
</IfModule>
